# BulliExplorer — copy to .env, fill in real values
APP_ENV=development
DEBUG=true
LOG_JSON=false

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/bulliexplorer

# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
RESYNC_TOKEN=

# GitHub fine-grained PAT — Contents: Read on svenhornaff/bulliexplorer
# Used by POST /internal/webhook/github to fetch committed files.
GITHUB_TOKEN=

# Generated when registering the webhook on GitHub (repo → Settings → Webhooks)
WEBHOOK_SECRET=

S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=bulliexplorer

# Sentry DSN — leave empty to disable error tracking
SENTRY_DSN=
